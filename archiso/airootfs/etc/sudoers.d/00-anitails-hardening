# AniTails sudoers hardening:
# - NO passwordless sudo (NOPASSWD is forbidden for amnesia).
# - 'amnesia' is NOT in 'wheel' by default; root/sudo remains locked unless an explicit
#   session-only administration password is set by the user at boot.
Defaults env_reset
Defaults passwd_tries=3
Defaults timestamp_timeout=0
Defaults use_pty
Defaults lecture="never"
%wheel ALL=(ALL:ALL) ALL

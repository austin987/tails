[Unit]
Description=AniTails Read-Only Virtio Boot Health Reporter (VM Test Harness Only)
ConditionVirtualization=vm
After=multi-user.target nftables.service anitails-create-netns.service gdm.service systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/anitails-virtio-boot-status
TimeoutStartSec=120s

[Install]
WantedBy=multi-user.target

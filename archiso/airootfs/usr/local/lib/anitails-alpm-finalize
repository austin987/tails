#!/usr/bin/env bash
# AniTails Post-Pacstrap Deterministic Finalization Script
#
# WHY THIS EXISTS (Critical Archiso 92-1 vs Debian live-build difference):
# In Debian live-build, `config/chroot_local-includes` is copied AFTER package installation.
# In Arch `mkarchiso` (92-1), `airootfs/` is copied BEFORE `pacstrap`! Consequently,
# packages installed during `pacstrap` may write `.pacnew` files, regenerate CA bundles,
# install `/usr/bin/swapon`, or reset systemd presets.
# Triggered via `/etc/pacman.d/hooks/zz-99-anitails-finalize.hook` (`mkarchiso` HookDir).
set -euo pipefail
trap 'echo "ERROR: anitails-alpm-finalize failed at line ${LINENO}: ${BASH_COMMAND}" >&2' ERR

echo "[anitails-finalize] 1/9 Neutralizing swapon..."
if [[ -x /usr/bin/swapon && ! -f /usr/bin/swapon.util-linux.disabled ]]; then
    mv /usr/bin/swapon /usr/bin/swapon.util-linux.disabled
    install -m 0755 /usr/local/lib/anitails-swapon-disabled /usr/bin/swapon
fi

echo "[anitails-finalize] 2/9 Rebuilding & auditing CA trust store (p11-kit blocklist)..."
if [[ -f /etc/ca-certificates/trust-source/blacklist/anitails-emudhra-distrust.p11-kit ]]; then
    install -d -m 0755 /etc/ca-certificates/trust-source/blocklist
    cp -f /etc/ca-certificates/trust-source/blacklist/anitails-emudhra-distrust.p11-kit \
          /etc/ca-certificates/trust-source/blocklist/anitails-emudhra-distrust.p11-kit
    cp -f /etc/ca-certificates/trust-source/blacklist/anitails-emudhra-distrust.p11-kit \
          /etc/ca-certificates/trust-source/anitails-emudhra-distrust.p11-kit
fi
if [[ -x /usr/bin/update-ca-trust ]]; then
    /usr/bin/update-ca-trust
fi
if [[ -x /usr/local/bin/anitails-verify-truststore && -f /etc/ssl/certs/ca-certificates.crt ]]; then
    /usr/local/bin/anitails-verify-truststore --bundle /etc/ssl/certs/ca-certificates.crt
fi

echo "[anitails-finalize] 3/9 Generating *.ko.zst pre-session NIC blacklist..."
if [[ -x /usr/local/lib/anitails-unblock-network ]]; then
    /usr/local/lib/anitails-unblock-network generate-blacklist
fi

echo "[anitails-finalize] 4/9 Compiling GNOME dconf database..."
if [[ -x /usr/bin/dconf ]]; then
    /usr/bin/dconf update
fi

echo "[anitails-finalize] 5/9 Masking forbidden services & neutralizing static nouveau blocklists..."
ln -sf /dev/null /etc/systemd/system/swap.target
ln -sf /dev/null /etc/systemd/system/sshd.service
ln -sf /dev/null /etc/systemd/system/sshd.socket
ln -sf /dev/null /etc/systemd/system/systemd-timesyncd.service
ln -sf /dev/null /etc/systemd/system/systemd-resolved.service
ln -sf /dev/null /etc/systemd/system/nvidia-persistenced.service
ln -sf /dev/null /etc/systemd/system/nvidia-suspend.service
ln -sf /dev/null /etc/systemd/system/nvidia-hibernate.service
ln -sf /dev/null /etc/systemd/system/nvidia-resume.service
ln -sf /dev/null /etc/systemd/system/nvidia-suspend-then-hibernate.service

for nv_modconf in /usr/lib/modprobe.d/nvidia-utils.conf /usr/lib/modprobe.d/nvidia-580xx-utils.conf /usr/lib/modprobe.d/nvidia.conf; do
    if [[ -f "${nv_modconf}" ]]; then
        cat > "${nv_modconf}" <<'EOF'
# Neutralized by AniTails zz-99-anitails-finalize.hook:
# Static `blacklist nouveau` and `NVreg_TemporaryFilePath=/var/tmp` removed to preserve
# pre-Turing nouveau fallback and prevent VRAM persistence on disk.
# Dynamic dispatch is managed in /run/modprobe.d/10-anitails-gpu.conf by anitails-gpu-select.
blacklist nova_core
blacklist nova_drm
EOF
    fi
done

echo "[anitails-finalize] 6/9 Enabling mandatory security, GPU guard & GDM desktop units..."
mkdir -p /etc/systemd/system/graphical.target.wants \
         /etc/systemd/system/multi-user.target.wants \
         /etc/systemd/system/sysinit.target.wants \
         /etc/systemd/system/local-fs.target.wants \
         /etc/systemd/system-generators
ln -sf /dev/null /etc/systemd/system-generators/systemd-gpt-auto-generator
ln -sf /usr/lib/systemd/system/graphical.target /etc/systemd/system/default.target
ln -sf /usr/lib/systemd/system/nftables.service /etc/systemd/system/multi-user.target.wants/nftables.service
ln -sf /usr/lib/systemd/system/apparmor.service /etc/systemd/system/multi-user.target.wants/apparmor.service
ln -sf /usr/lib/systemd/system/NetworkManager.service /etc/systemd/system/multi-user.target.wants/NetworkManager.service
ln -sf /usr/lib/systemd/system/gdm.service /etc/systemd/system/display-manager.service
ln -sf /etc/systemd/system/anitails-gpu-guard.service /etc/systemd/system/sysinit.target.wants/anitails-gpu-guard.service
ln -sf /etc/systemd/system/anitails-create-netns.service /etc/systemd/system/sysinit.target.wants/anitails-create-netns.service
ln -sf /etc/systemd/system/anitails-onion-grater.service /etc/systemd/system/multi-user.target.wants/anitails-onion-grater.service
ln -sf /etc/systemd/system/run-initramfs.mount /etc/systemd/system/local-fs.target.wants/run-initramfs.mount
ln -sf /etc/systemd/system/anitails-initramfs-restore.service /etc/systemd/system/multi-user.target.wants/anitails-initramfs-restore.service
ln -sf /etc/systemd/system/anitails-remove-overlayfs-dirs.service /etc/systemd/system/multi-user.target.wants/anitails-remove-overlayfs-dirs.service
ln -sf /etc/systemd/system/anitails-shutdown-on-media-removal.service /etc/systemd/system/graphical.target.wants/anitails-shutdown-on-media-removal.service
ln -sf /etc/systemd/system/anitails-virtio-boot-status.service /etc/systemd/system/sysinit.target.wants/anitails-virtio-boot-status.service

echo "[anitails-finalize] 7/9 Cleaning .pacnew files & enforcing Tor directory permissions..."
find /etc -name "*.pacnew" -delete 2>/dev/null || true
TOR_UID="$(id -u tor 2>/dev/null || echo 43)"
TOR_GID="$(id -g tor 2>/dev/null || echo 43)"
install -d -m 0700 -o "${TOR_UID}" -g "${TOR_GID}" /var/lib/tor
install -d -m 0750 -o 0 -g 0 /etc/polkit-1/rules.d
if [[ -f /etc/tor/torrc ]]; then
    chown "0:${TOR_GID}" /etc/tor/torrc
    chmod 0640 /etc/tor/torrc
fi

echo "[anitails-finalize] 8/9 Rebuilding initramfs-linux-anitails.img..."
if [[ -x /usr/bin/mkinitcpio ]] && compgen -G "/usr/lib/modules/*/vmlinuz" >/dev/null; then
    /usr/bin/mkinitcpio -P
fi

echo "[anitails-finalize] 9/9 Marking airootfs finalization complete."
touch /etc/anitails-finalized

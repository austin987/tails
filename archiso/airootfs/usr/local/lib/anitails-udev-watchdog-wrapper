#!/usr/bin/env bash
# Monitor the Archiso live boot medium (/run/archiso/bootmnt) and trigger
# immediate emergency session termination + RAM wipe poweroff upon physical removal.
# Ported from Tails udev-watchdog-wrapper (/lib/live/mount/medium -> /run/archiso/bootmnt).
set -euo pipefail

BOOTMNT="${ANITAILS_BOOTMNT:-/run/archiso/bootmnt}"
WATCHDOG_BIN="${ANITAILS_WATCHDOG_BIN:-/usr/bin/anitails-udev-watchdog}"

emergency_poweroff() {
    logger -t anitails-watchdog -p authpriv.emerg "EMERGENCY: Live boot medium removed! Killing user session and wiping RAM."
    /usr/bin/loginctl --signal=9 kill-user amnesia 2>/dev/null || true
    /usr/bin/systemctl stop gdm.service 2>/dev/null || true
    /usr/bin/systemctl --signal=9 kill gdm.service 2>/dev/null || true
    /usr/bin/loginctl --signal=9 kill-user gdm 2>/dev/null || true
    # Close any unlocked LUKS2 Persistent Storage immediately
    /usr/local/bin/anitails-persistence lock 2>/dev/null || true
    # Trigger immediate systemd-shutdown -> /run/initramfs/shutdown RAM wipe
    /usr/bin/systemctl --force poweroff
}

resolve_boot_block_dev() {
    local src
    src="$(/usr/bin/findmnt -no SOURCE "${BOOTMNT}" 2>/dev/null || true)"
    if [[ -z "${src}" || ! -b "${src}" ]]; then
        echo ""
        return
    fi
    # Skip virtual/RAM/loopback/Ventoy device-mapper mounts where no physical USB/CD node is bound
    case "${src}" in
        /dev/loop*|/dev/dm-*|/dev/mapper/*|/dev/ram*|/dev/zram*)
            echo ""
            return
            ;;
    esac
    # Resolve partition (e.g. /dev/sdb1) to parent whole disk (/dev/sdb) if applicable
    local pkname
    pkname="$(/usr/bin/lsblk -no PKNAME "${src}" 2>/dev/null | head -n1 | tr -d '[:space:]')"
    if [[ -n "${pkname}" && -b "/dev/${pkname}" ]]; then
        echo "/dev/${pkname}"
    else
        echo "${src}"
    fi
}

is_medium_actually_gone() {
    local dev="$1"
    if [[ ! -b "${dev}" ]]; then
        return 0
    fi
    local bname size_sectors
    bname="$(basename "${dev}")"
    size_sectors="$(cat "/sys/class/block/${bname}/size" 2>/dev/null || echo "0")"
    if [[ -z "${size_sectors}" || "${size_sectors}" == "0" ]]; then
        return 0
    fi
    if ! /usr/bin/dd if="${dev}" of=/dev/null bs=512 count=1 status=none 2>/dev/null; then
        return 0
    fi
    return 1
}

BOOT_DEV="$(resolve_boot_block_dev)"
if [[ -z "${BOOT_DEV}" || ! -b "${BOOT_DEV}" ]]; then
    logger -t anitails-watchdog "Boot medium is RAM/loopback/mapper; skipping physical block-removal watchdog."
    exit 0
fi

DEV_UDEV_PATH="$(/usr/bin/udevadm info --query=path --name="${BOOT_DEV}")"
DEV_TYPE="$(/usr/bin/udevadm info --query=property --name="${BOOT_DEV}" | awk -F= '$1=="ID_TYPE"{print $2; exit}')"
if [[ "${DEV_TYPE}" != "cd" ]]; then
    DEV_TYPE="disk"
fi

while true; do
    if "${WATCHDOG_BIN}" "${DEV_UDEV_PATH}" "${DEV_TYPE}"; then
        # Physical USB disk `ACTION=remove` is unconditional; CD/DVD `ACTION=change` can also
        # be emitted by udisks2/cdrom_id media probes during boot, so verify actual ejection!
        if [[ "${DEV_TYPE}" == "disk" ]] || is_medium_actually_gone "${BOOT_DEV}"; then
            emergency_poweroff
            exit 0
        fi
        logger -t anitails-watchdog "Ignored benign udev change probe on ${BOOT_DEV} (medium still present)."
        sleep 0.2
    else
        sleep 1
    fi
done

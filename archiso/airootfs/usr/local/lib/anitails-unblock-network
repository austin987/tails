#!/usr/bin/env bash
# Generate or unblock the pre-session NIC kernel module blacklist on Arch Linux.
# IMPORTANT Arch difference vs Debian Tails (80-block-network):
# Arch compresses kernel modules as *.ko.zst (not *.ko). Matching only *.ko
# would silently fail open and leave NIC drivers unblocked!
set -euo pipefail

BLACKLIST_FILE="${ANITAILS_NET_BLACKLIST:-/etc/modprobe.d/90-all-net-blacklist.conf}"
MODULES_ROOT="${ANITAILS_MODULES_ROOT:-/usr/lib/modules}"
CMDLINE_FILE="${ANITAILS_CMDLINE_FILE:-/proc/cmdline}"

strip_ko_ext() {
    local base
    base="$(basename "$1")"
    base="${base%.zst}"
    base="${base%.xz}"
    base="${base%.gz}"
    base="${base%.ko}"
    printf "%s\n" "${base}"
}

generate_blacklist() {
    mkdir -p "$(dirname "${BLACKLIST_FILE}")"
    {
        echo "# Generated by anitails-unblock-network (blocks all physical NIC modules until session consent)"
        if [[ -d "${MODULES_ROOT}" ]]; then
            find "${MODULES_ROOT}" -type f \( -path "*/kernel/drivers/net/*" -o -path "*/kernel/drivers/bluetooth/*" \) \
                \( -name "*.ko" -o -name "*.ko.zst" -o -name "*.ko.xz" -o -name "*.ko.gz" \) | while read -r modpath; do
                modname="$(strip_ko_ext "${modpath}")"
                if [[ "${modname}" == "veth" ]]; then
                    continue
                fi
                printf "install %s /bin/false\n" "${modname}"
            done | sort -u
        fi
    } > "${BLACKLIST_FILE}"
}

unblock_network() {
    if [[ -r "${CMDLINE_FILE}" ]] && grep -qw "anitails.offline=1" "${CMDLINE_FILE}"; then
        logger -t anitails-net "anitails.offline=1 set; keeping all NIC modules blocked."
        exit 0
    fi
    # Verify atomic firewall is loaded before unblocking NIC drivers!
    if ! /usr/bin/nft list table inet anitails_filter >/dev/null 2>&1; then
        logger -t anitails-net -p authpriv.crit "Refusing to unblock NIC drivers: table inet anitails_filter is NOT loaded!"
        exit 1
    fi
    rm -f "${BLACKLIST_FILE}"
    sync
    /usr/bin/udevadm trigger --action=add --subsystem-match=net || true
}

case "${1:-}" in
    generate-blacklist)
        generate_blacklist
        ;;
    unblock)
        unblock_network
        ;;
    *)
        echo "Usage: $0 {generate-blacklist|unblock}" >&2
        exit 2
        ;;
esac

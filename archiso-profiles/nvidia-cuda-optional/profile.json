{
  "profile_id": "nvidia-cuda-optional",
  "display_name": "AniTails Optional Compute Profile (Modern NVIDIA + CUDA 13.4 / OpenCL — Opt-In Only)",
  "default_profile": false,
  "opt_in_only": true,
  "proprietary_userspace": true,
  "proprietary_userspace_license": "LicenseRef-NVIDIA-Driver-License-Agreement AND LicenseRef-NVIDIA-CUDA",
  "kernel_module_license": "MIT AND GPL-2.0-only",
  "proprietary_kernel_blob": false,
  "runtime_dkms": false,
  "min_compute_capability": "7.5",
  "supported_nvidia_architectures_compute": [
    "Turing",
    "Ampere",
    "Ada_Lovelace",
    "Hopper",
    "Blackwell"
  ],
  "incompatible_cuda_13_architectures": [
    "Maxwell (SM 5.x dropped in CUDA 13)",
    "Pascal (SM 6.x dropped in CUDA 13)",
    "Volta (SM 7.0 dropped in CUDA 13)",
    "Kepler/Fermi/Tesla (EOL)"
  ],
  "extra_packages": [
    "nvidia-open-anitails",
    "nvidia-utils",
    "opencl-nvidia",
    "egl-wayland",
    "egl-wayland2",
    "egl-gbm",
    "nvidia-prime",
    "cuda"
  ]
}

{
  "profile_id": "nvidia-modern",
  "display_name": "AniTails Modern NVIDIA Open-Kernel-Module Image (Turing / Ampere / Ada / Hopper / Blackwell)",
  "default_profile": false,
  "proprietary_userspace": true,
  "proprietary_userspace_license": "LicenseRef-NVIDIA-Driver-License-Agreement",
  "kernel_module_license": "MIT AND GPL-2.0-only",
  "proprietary_kernel_blob": false,
  "runtime_dkms": false,
  "preserves_nouveau_fallback_for_pre_turing": true,
  "supported_nvidia_architectures_3d": [
    "Turing",
    "Ampere",
    "Ada_Lovelace",
    "Hopper",
    "Blackwell"
  ],
  "fallback_nouveau_architectures": [
    "Tesla_NV50",
    "Fermi",
    "Kepler",
    "Maxwell",
    "Pascal",
    "Volta"
  ],
  "driver_stack": {
    "kernel_package": "nvidia-open-anitails",
    "userspace_packages": ["nvidia-utils", "egl-wayland", "egl-wayland2", "egl-gbm", "nvidia-prime"],
    "firmware": ["nvidia-utils GSP firmware (gsp_tu10x.bin, gsp_ga10x.bin)", "linux-firmware-nvidia"]
  },
  "extra_packages": [
    "nvidia-open-anitails",
    "nvidia-utils",
    "egl-wayland",
    "egl-wayland2",
    "egl-gbm",
    "nvidia-prime"
  ]
}

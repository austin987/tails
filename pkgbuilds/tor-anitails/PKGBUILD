# Maintainer: AniTails Security Engineering
# Upstream Target: Tor 0.4.9.16 (satisfies Tails 7.16 >= 0.4.9.15 Desc=3/Microdesc=3 consensus requirement)
# Linked against frozen Arch [core] openssl 3.6.5-1 ABI (never mix with core-testing openssl 4.1.0-1).

pkgname=tor-anitails
_pkgname=tor
pkgver=0.4.9.16
pkgrel=1
pkgdesc='Anonymizing overlay network daemon (>= 0.4.9.15 required by Tor authorities since 2026-10-28)'
arch=('x86_64')
url='https://www.torproject.org/'
license=('BSD-3-Clause')
depends=('glibc' 'libcap' 'libevent' 'libseccomp' 'openssl' 'systemd-libs' 'xz' 'zlib' 'zstd')
makedepends=('ca-certificates' 'systemd')
provides=("tor=${pkgver}")
conflicts=('tor')
backup=('etc/tor/torrc')
source=(
  "https://dist.torproject.org/${_pkgname}-${pkgver}.tar.gz"
  "https://dist.torproject.org/${_pkgname}-${pkgver}.tar.gz.asc"
  'tor.sysusers'
  'tor.tmpfiles'
  'tor.service'
  'disable-openssl-dynamic-linking-warning.patch'
)
# Official SHA-256 from https://dist.torproject.org/tor-0.4.9.16.tar.gz.sha256sum
sha256sums=(
  '6180e193152f4525bdca5475168419b2a2035b963c3c60162a187f86e6160e48'
  'SKIP'
  '252c86feac75502dae5e5582eaf7e168aaaf76feb37753fa38436709d7c35b8e'
  '4bd2fe756350f32b4c31eb92c3989b98f73f0f9d7da89b9b470c980bea0bc269'
  'aab12e6755246e10e69dd78a5280cf52ad16df553558dfba5fb174b09b6b4dc9'
  '7133814236ba5b51816bd5f9bda38f480522a82e9edbf7676a52986b865b71f0'
)
# Official Tor Core Maintainer PGP Keys (matching Arch packaging/packages/tor):
validpgpkeys=(
  '2133BC600AB133E1D826D173FE43009C4607B1FB' # Nick Mathewson <nickm@torproject.org>
  'B74417EDDF22AC9F9E90F49142E86A2A11F48D36' # David Goulet <dgoulet@torproject.org>
  '1C1BC007A9F607AA8152C040BEA7B180B1491921' # Alexander Færøy <ahf@torproject.org>
)

prepare() {
  cd "${_pkgname}-${pkgver}"
  patch -Np1 < ../disable-openssl-dynamic-linking-warning.patch
}

build() {
  cd "${_pkgname}-${pkgver}"
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --enable-systemd \
    --enable-gpl
  make
}

check() {
  cd "${_pkgname}-${pkgver}"
  make check
}

package() {
  cd "${_pkgname}-${pkgver}"
  make DESTDIR="${pkgdir}" install
  mv "${pkgdir}/etc/tor/torrc.sample" "${pkgdir}/etc/tor/torrc"
  install -Dm0644 "${srcdir}/tor.sysusers" "${pkgdir}/usr/lib/sysusers.d/tor.conf"
  install -Dm0644 "${srcdir}/tor.tmpfiles" "${pkgdir}/usr/lib/tmpfiles.d/tor.conf"
  install -Dm0644 "${srcdir}/tor.service"  "${pkgdir}/usr/lib/systemd/system/tor.service"
  install -Dm0644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

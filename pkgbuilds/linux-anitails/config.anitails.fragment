# AniTails Kernel Security Hardening Kconfig Fragment
# Merged onto official Arch Linux `config.x86_64` (7.2.15.arch1-1 baseline -> Linux 7.3.3)
#
# Key guarantees:
# 1. Exact deterministic kernelrelease `7.3.3-anitails1` (`LOCALVERSION_AUTO=n`).
# 2. Full Arch Linux x86_64 hardware support (USB3 xHCI, NVMe/VMD, SATA/AHCI, VirtIO,
#    QEMU/VirtualBox/VMware/Hyper-V KMS, Intel/AMD/Nouveau DRM, HID/I2C touchpads, Wi-Fi/NICs).
# 3. Initramfs ZSTD/XZ/GZIP decompression + tmpfs POSIX ACL/xattr (required by Archiso
#    overlayfs cowspace and systemd-logind /dev/dri/card0 Wayland uaccess ACLs).
# 4. AppArmor LSM + Landlock + Yama + Lockdown + init_on_free + SHA-512 module signing.
# 5. Strips non-PC bloat (InfiniBand, ISDN, Amateur Radio, Analog/Digital TV tuners,
#    Staging, DWARF/BTF debug info, Rust) for reduced attack surface & fast CI builds.

# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_RUST is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_SCHED_CLASS_EXT is not set

# --- Boot-Critical Initramfs, Live ISO, OverlayFS & Tmpfs ACL/xattr ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_XZ=y
CONFIG_RD_GZIP=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XZ=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=m
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=m
CONFIG_OVERLAY_FS=m
CONFIG_BLK_DEV_LOOP=m
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_NVME_CORE=m
CONFIG_BLK_DEV_NVME=m
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_SCSI=m
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=m

# --- Mandatory Access Control & Kernel Self-Protection ---
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_SECURITY_APPARMOR_EXPORT_BINARY=y
CONFIG_SECURITY_APPARMOR_PARANOID_LOAD=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor,bpf"

CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_PAGE_POISONING=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# --- Disk Encryption, Namespaces & Fail-Closed Tor Firewall ---
CONFIG_MD=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA512=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_VETH=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_NAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_LOG=m
CONFIG_NFT_COUNTER=m
CONFIG_NFT_SOCKET=m

# --- Module Signature Enforcement, Intel CET/IBT & Hardware IOMMU DMA Protection ---
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_X86_KERNEL_IBT=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y

# --- Display Fallback (simpledrm) & Conflict-Free Bare-Metal + VM GPU KMS Baseline ---
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_VIRTIO_GPU=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_QXL=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_NOUVEAU_BACKLIGHT=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
# CONFIG_NOVA_CORE is not set
# CONFIG_DRM_NOVA is not set

# --- Trim Attack-Surface & Non-PC Legacy Subsystems ---
# CONFIG_BT is not set
# CONFIG_FIREWIRE is not set
# CONFIG_INFINIBAND is not set
# CONFIG_ISDN is not set
# CONFIG_HAMRADIO is not set
# CONFIG_CAN is not set
# CONFIG_ATM is not set
# CONFIG_RDS is not set
# CONFIG_TIPC is not set
# CONFIG_IP_DCCP is not set
# CONFIG_IP_SCTP is not set
# CONFIG_STAGING is not set
# CONFIG_COMEDI is not set
# CONFIG_FPGA is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
